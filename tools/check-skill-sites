#!/usr/bin/env python3
"""Neuter each refusal site in skills/load_skill.py and require ITS test to notice (SK-07/08).

This loader raises twelve codes from twenty places, so eight sites have a neighbour that can
answer for them. The mechanism -- site keys, the table reconciled both ways, killed only by the
named test, never by any non-zero exit -- is `tools/site_sweep.py`, shared with the workflow and
pi sweeps. The table was written from `--discover` (2026-09-26): each site's most direct case
among the tests its neuter fails, never the vocabulary census, which notices any vanished code.

Run: python3 tools/check-skill-sites   (--discover lists the tests each neuter fails)
"""

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "tools"))
import site_sweep  # the tools directory is not a package: imported by path, after it is on sys.path

SOURCE = ROOT / "skills/load_skill.py"
TESTS = ROOT / "tests/skill_schema.py"


# The test whose failure is the evidence each site is pinned, keyed as `site_sweep.sites` spells it.
EXPECTED = {
    "safe_path:unsafe_path:1": "test_backslash_in_a_path",
    "safe_path:unsafe_path:2": "test_parent_segment_in_a_path",
    "require_fields:malformed_manifest:1": "test_a_manifest_missing_a_required_field",
    "structure:version_mismatch:1": "test_wrong_schema_string",
    "structure:incompatible_action:1": "test_more_required_actions_than_the_limit",
    "structure:unknown_action:1": "test_action_outside_the_catalogue",
    "structure:missing_dependency:1": "test_more_dependencies_than_the_limit",
    "structure:conflicting_dependency:1": "test_one_skill_pinned_at_two_versions",
    "structure:traversal_budget:1": "test_more_references_than_the_limit",
    "structure:duplicate_reference:1": "test_duplicate_reference_identity",
    "structure:traversal_budget:2": "test_a_deep_path_declaring_a_shallow_depth",
    "structure:traversal_budget:3": "test_a_declared_depth_that_disagrees_with_its_path",
    "discover:retired_skill:1": "test_retired_skill_does_not_load",
    "discover:authority_widening:1": "test_action_the_caller_does_not_hold",
    "discover:missing_dependency:1": "test_required_dependency_absent",
    "read_package:unsafe_path:1": "test_reading_through_a_symlink_that_leaves_the_package",
    "load:context_budget:1": "test_entry_larger_than_the_budget",
    "revise:version_mismatch:1": "test_revision_of_a_different_skill",
    "revise:version_mismatch:2": "test_revision_that_does_not_advance",
    "revise:retired_skill:1": "test_revision_of_a_retired_skill",
}


sys.exit(site_sweep.main(SOURCE, TESTS, EXPECTED))
