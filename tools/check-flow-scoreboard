def main(argv):
    if argv == ["--control"]:
        return control()
    if argv:
        raise SystemExit("usage: check-flow-scoreboard [--control]")
    hosts = {flow: observe(ROOT, entry["host"]) for flow, entry in FLOWS.items() if "host" in entry}
    problems, counts = judge(ROOT, (ROOT / SCHEMATICS).read_text(), FLOWS, hosts)
    for flow in sorted(FLOWS):
        entry = FLOWS[flow]
        print(f"  {flow} " + (f"L2 {entry['l2']}" if "l2" in entry else f"reasoned, lands with {entry.get('lands_with')}"))
    for flow in sorted(hosts):
        print(f"  {host_verdict(flow, hosts[flow])[1]}")
    return report(problems, counts)


def observe(root, relative):
    """Acquire one host record's observation for `host_verdict`: the record, its ancestry and the src changes since
    it (from git, None when this copy has no history), and the release it names, recomputed from disk."""
    path = root / relative
    if not path.is_file():
        return {"record": None}
    record = json.loads(path.read_text())
    sha = str(record.get("source_sha", ""))
    ancestry = subprocess.run(["git", "-C", str(root), "merge-base", "--is-ancestor", sha, "HEAD"],
                              capture_output=True, text=True, check=False)
    ancestor = None if ancestry.returncode not in (0, 1) else ancestry.returncode == 0
    changed = []
    if ancestor:
        changed = subprocess.run(["git", "-C", str(root), "diff", "--name-only", sha, "HEAD", "--",
                                  "src", "Cargo.toml", "Cargo.lock"],
                                 capture_output=True, text=True, check=True).stdout.split()
    release = RELEASES / str(record.get("release_manifest_sha256", ""))
    engine, manifest = release / "habitat-engine", release / "manifest.json"
    release_digest = hashlib.sha256(engine.read_bytes()).hexdigest() if engine.is_file() else None
    manifest_source = json.loads(manifest.read_text()).get("source_commit") if manifest.is_file() else None
    return {"record": record, "ancestor": ancestor, "changed": changed, "release_digest": release_digest,
            "manifest_source": manifest_source}


sys.exit(main(sys.argv[1:]))
