FLOW_CELL = re.compile(r"^(F\d\d) (\S+) → (\S+):")


def cs06_section(text):
    """The lines of the `## CS06` section only: every schematic has an arrows table of the same
    shape, and the flows are CS06's (measured: the first arrows table in the file is CS01's)."""
    lines = text.splitlines()
    start = next((index for index, line in enumerate(lines) if line.startswith("## CS06 ")), None)
    if start is None:
        return []
    end = next((index for index in range(start + 1, len(lines)) if lines[index].startswith("## ")), len(lines))
    return lines[start + 1:end]


def world(text):
    """{flow: {(from, to)}} from the CS06 arrows table, read cell by cell."""
    flows = {}
    in_table = False
    for line in cs06_section(text):
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")] if line.startswith("|") else None
        if cells and cells[:4] == ["Arrow", "From → to", "Meaning", "Condition / evidence"]:
            in_table = True
            continue
        if not in_table:
            continue
        if cells is None:
            break
        if len(cells) < 4 or not re.fullmatch(r"E\d\d", cells[0]):
            continue
        found = FLOW_CELL.match(cells[3])
        if found:
            flows.setdefault(found.group(1), set()).add(tuple(sorted((found.group(2), found.group(3)))))
    return flows


def test_resolves(root, spec):
    """Whether `<file>::<fn>` names a `#[test]` function in that file."""
    if "::" not in spec:
        return False
    file, name = spec.split("::", 1)
    path = root / file
    if not path.is_file():
        return False
    lines = path.read_text(errors="replace").splitlines()
    for index, line in enumerate(lines):
        if re.match(rf"^\s*(?:async\s+)?fn {re.escape(name)}\(", line):
            # The attribute block directly above this fn: attributes and doc comments only, so a
            # `#[test]` belonging to an earlier function cannot be credited to a helper.
            above = index - 1
            while above >= 0 and lines[above].strip().startswith(("#[", "///", "//")):
                if lines[above].strip() == "#[test]":
                    return True
                above -= 1
            return False
    return False


def judge(root, text, flows):
    """(problems, counts). Pure over its inputs, so the control can reach every branch."""
    found = world(text)
    problems = []
    if not found:
        problems.append("the CS06 arrows table yielded no flow; the world is unreadable")
    for flow in sorted(set(found) - set(flows)):
        problems.append(f"unexplained {flow}: in CS06 with no l2 test and no reason")
    for flow in sorted(set(flows) - set(found)):
        problems.append(f"stale {flow}: named here but not in CS06")
    l2 = reasoned = 0
    for flow in sorted(set(flows) & set(found)):
        entry = flows[flow]
        if "l2" in entry:
            if test_resolves(root, entry["l2"]):
                l2 += 1
            else:
                problems.append(f"{flow}: l2 names {entry['l2']}, which is not a #[test] in the tree")
        elif str(entry.get("reason", "")).strip() and str(entry.get("lands_with", "")).strip():
            reasoned += 1
            if "partial" in entry and not test_resolves(root, entry["partial"]):
                problems.append(f"{flow}: partial names {entry['partial']}, which is not a #[test] in the tree")
        else:
            problems.append(f"unexplained {flow}: an entry needs an l2 test, or a reason and lands_with")
    unexplained = len(found) - l2 - reasoned
    return problems, {"flows": len(found), "l2": l2, "reasoned": reasoned, "unexplained": unexplained}


def report(problems, counts):
    for problem in problems:
        print(f"  {problem}")
    print(f"flows={counts['flows']} l2={counts['l2']} reasoned={counts['reasoned']} "
          f"unexplained={counts['unexplained']}")
    print("verdict=" + ("FAIL" if problems else "PASS"))
    return 1 if problems else 0


def control():
    table = ("## CS05 · earlier\n\n| Arrow | From → to | Meaning | Condition / evidence |\n| --- | --- | --- | --- |\n"
             "| E01 | K1 → K2 | forward | F05 wrong → section: ignored |\n\n## CS06 · flows\n\n"
             "| Arrow | From → to | Meaning | Condition / evidence |\n| --- | --- | --- | --- |\n"
             "| E01 | K1 → K2 | forward | F01 a → b: x |\n| E02 | K2 → K1 | return | F01 b → a: y |\n"
             "| E03 | K1 → K1 | forward | F02 a → c: z |\n\n| E09 | K1 → K1 | forward | F09 after → table: ignored |\n"
             "\n## CS07 · later\n\n| Arrow | From → to | Meaning | Condition / evidence |\n| --- | --- | --- | --- |\n"
             "| E01 | K1 → K2 | forward | F07 wrong → section: ignored |\n")
    reason = {"reason": "not yet", "lands_with": "S1"}
    with tempfile.TemporaryDirectory() as raw:
        root = Path(raw)
        (root / "tests").mkdir()
        (root / "tests/t.rs").write_text("#[test]\nfn crosses() {}\n\nfn helper() {}\n")
        cases = [
            ("both flows accounted", {"F01": {"l2": "tests/t.rs::crosses"}, "F02": reason},
             [], (2, 1, 1, 0)),
            ("an unexplained flow", {"F01": reason},
             ["unexplained F02: in CS06 with no l2 test and no reason"], (2, 0, 1, 1)),
            ("a stale entry", {"F01": reason, "F02": reason, "F07": reason},
             ["stale F07: named here but not in CS06"], (2, 0, 2, 0)),
            ("an l2 naming a helper, not a test", {"F01": {"l2": "tests/t.rs::helper"}, "F02": reason},
             ["F01: l2 names tests/t.rs::helper, which is not a #[test] in the tree"], (2, 0, 1, 1)),
            ("a reason without lands_with", {"F01": {"reason": "later"}, "F02": reason},
             ["unexplained F01: an entry needs an l2 test, or a reason and lands_with"], (2, 0, 1, 1)),
            ("a partial naming no test", {"F01": {**reason, "partial": "tests/t.rs::absent"}, "F02": reason},
             ["F01: partial names tests/t.rs::absent, which is not a #[test] in the tree"], (2, 0, 2, 0)),
        ]
        failed = 0
        for label, flows, want, counts in cases:
            problems, got = judge(root, table, flows)
            ok = problems == want and (got["flows"], got["l2"], got["reasoned"], got["unexplained"]) == counts
            failed += not ok
            print(f"{'ok  ' if ok else 'FAIL'} {label}: {problems} {got}")
        problems, _ = judge(root, "no table here\n", {})
        ok = problems == ["the CS06 arrows table yielded no flow; the world is unreadable"]
        failed += not ok
        print(f"{'ok  ' if ok else 'FAIL'} an empty world refuses: {problems}")
    print(f"control verdict={'FAIL' if failed else 'PASS'} cases={len(cases) + 1}")
    return 1 if failed else 0


def main(argv):
    if argv == ["--control"]:
        return control()
    if argv:
        raise SystemExit("usage: check-flow-scoreboard [--control]")
    problems, counts = judge(ROOT, (ROOT / SCHEMATICS).read_text(), FLOWS)
    for flow in sorted(FLOWS):
        entry = FLOWS[flow]
        print(f"  {flow} " + (f"L2 {entry['l2']}" if "l2" in entry else f"reasoned, lands with {entry.get('lands_with')}"))
    return report(problems, counts)


sys.exit(main(sys.argv[1:]))
