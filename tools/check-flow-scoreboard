#!/usr/bin/env python3
"""The flow scoreboard: every declared cross-module flow is proven at L2 or carries its reason.

The WORLD is the CS06 arrows table in `docs/corpus-schematics.md` -- forty directional arrows derived
from the declared semantic flows -- read by cell, not by pattern over the whole line. Every flow found
there must have an entry below and every entry must name a flow found there (reconciled both ways,
so a flow added to the corpus cannot pass silently and a retired one cannot linger).

An entry is either `l2`: the one test that makes the flow done -- a case that crosses both modules'
real doors through the binary -- named as `<file>::<fn>` and resolved to a `#[test]` in that file;
or `reason`: why it is not L2 yet and the slice it `lands_with`, optionally naming a `partial` test
that covers part of it. A partial is never counted as L2 (HEE3_MASTER_PLAN_20260926.md §5).

Prints `flows=N l2=L reasoned=R unexplained=U` and refuses any unexplained flow, any unresolved test
and an empty world. `--control` proves each refusal fires on its own diagnostic.

Run: python3 tools/check-flow-scoreboard [--control]
"""

import re
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SCHEMATICS = "docs/corpus-schematics.md"

SOCKET = "tests/t28_socket.rs"

