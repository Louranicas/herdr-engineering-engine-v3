FLOW_CELL = re.compile(r"^(F\d\d) (\S+) → (\S+):")


def cs06_section(text):
    """The lines of the `## CS06` section only: every schematic has an arrows table of the same
    shape, and the flows are CS06's (measured: the first arrows table in the file is CS01's)."""
    lines = text.splitlines()
    start = next((index for index, line in enumerate(lines) if line.startswith("## CS06 ")), None)
    if start is None:
        return []
    end = next((index for index in range(start + 1, len(lines)) if lines[index].startswith("## ")), len(lines))
    return lines[start + 1:end]


def world(text):
    """{flow: {(from, to)}} from the CS06 arrows table, read cell by cell."""
    flows = {}
    in_table = False
    for line in cs06_section(text):
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")] if line.startswith("|") else None
        if cells and cells[:4] == ["Arrow", "From → to", "Meaning", "Condition / evidence"]:
            in_table = True
            continue
        if not in_table:
            continue
        if cells is None:
            break
        if len(cells) < 4 or not re.fullmatch(r"E\d\d", cells[0]):
            continue
        found = FLOW_CELL.match(cells[3])
        if found:
            flows.setdefault(found.group(1), set()).add(tuple(sorted((found.group(2), found.group(3)))))
    return flows


def test_resolves(root, spec):
    """Whether `<file>::<fn>` names a `#[test]` function in that file."""
    if "::" not in spec:
        return False
    file, name = spec.split("::", 1)
    path = root / file
    if not path.is_file():
        return False
    lines = path.read_text(errors="replace").splitlines()
    for index, line in enumerate(lines):
        if re.match(rf"^\s*(?:async\s+)?fn {re.escape(name)}\(", line):
            # The attribute block directly above this fn: attributes and doc comments only, so a
            # `#[test]` belonging to an earlier function cannot be credited to a helper.
            above = index - 1
            while above >= 0 and lines[above].strip().startswith(("#[", "///", "//")):
                if lines[above].strip() == "#[test]":
                    return True
                above -= 1
            return False
    return False


def host_verdict(flow, seen, lines=None):
    """('l2' | 'note' | 'refused', line) for one host observation, pure. `seen` is what main acquired: the parsed
    `record` (None when absent), `ancestor` (bool, or None with no history to ask), `changed` (paths under src,
    Cargo.toml, Cargo.lock since the record's sha), `release_digest` (the engine's sha256 recomputed from the release
    directory, None when this machine holds no such release) and `manifest_source` (that release's source_commit)."""
    record = seen.get("record")
    if record is None:
        return "note", f"{flow}: host=0 (record absent)"
    sha = record.get("source_sha")
    if record.get("schema") != HOST_SCHEMA or record.get("flow") != flow:
        return "refused", f"{flow}: host record refused: schema {record.get('schema')!r} flow {record.get('flow')!r}"
    if record.get("dirty") != 0:
        return "refused", f"{flow}: host record refused: dirty={record.get('dirty')}"
    asserted = record.get("asserted", [])
    wanted = (lines or HOST_LINES).get(flow)
    if wanted is None:
        return "refused", f"{flow}: host record refused: no asserted-line contract for {flow}"
    for prefix, value in wanted:
        if not any(line.startswith(prefix) and value in line for line in asserted):
            return "refused", f"{flow}: host record refused: missing line {prefix.strip()!r}"
    if seen.get("manifest_source") is not None and seen["manifest_source"] != sha:
        return "refused", (f"{flow}: host record refused: source_sha {sha} != manifest source_commit "
                           f"{seen['manifest_source']}")
    if seen.get("release_digest") is not None and seen["release_digest"] != record.get("engine_sha256"):
        return "refused", (f"{flow}: host record refused: engine digest {record.get('engine_sha256')} != release "
                           f"{seen['release_digest']}")
    if seen.get("ancestor") is None:
        return "note", f"{flow}: host record unverifiable here (no history to ask)"
    if not seen["ancestor"] or seen.get("changed"):
        return "note", f"{flow}: reasoned (host record stale: {sha})"
    if seen.get("release_digest") is None:
        return "note", f"{flow}: host_digest=unverified"
    return "l2", f"{flow}: L2 by host record {sha}"


def judge(root, text, flows, hosts=None, lines=None):
    """(problems, counts). Pure over its inputs, so the control can reach every branch. `hosts` is
    {flow: observation} for each entry that names a host record (see `host_verdict`)."""
    hosts = hosts or {}
    found = world(text)
    problems = []
    host = 0
    if not found:
        problems.append("the CS06 arrows table yielded no flow; the world is unreadable")
    for flow in sorted(set(found) - set(flows)):
        problems.append(f"unexplained {flow}: in CS06 with no l2 test and no reason")
    for flow in sorted(set(flows) - set(found)):
        problems.append(f"stale {flow}: named here but not in CS06")
    l2 = reasoned = 0
    for flow in sorted(set(flows) & set(found)):
        entry = flows[flow]
        if "l2" in entry:
            if test_resolves(root, entry["l2"]):
                l2 += 1
            else:
                problems.append(f"{flow}: l2 names {entry['l2']}, which is not a #[test] in the tree")
        elif "host" in entry and host_verdict(flow, hosts.get(flow, {}), lines)[0] == "l2":
            l2 += 1
            host += 1
        elif str(entry.get("reason", "")).strip() and str(entry.get("lands_with", "")).strip():
            reasoned += 1
            if "host" in entry:
                kind, line = host_verdict(flow, hosts.get(flow, {}), lines)
                if kind == "refused":
                    problems.append(line)
            if "partial" in entry and not test_resolves(root, entry["partial"]):
                problems.append(f"{flow}: partial names {entry['partial']}, which is not a #[test] in the tree")
        else:
            problems.append(f"unexplained {flow}: an entry needs an l2 test, or a reason and lands_with")
    unexplained = len(found) - l2 - reasoned
    return problems, {"flows": len(found), "l2": l2, "host": host, "reasoned": reasoned, "unexplained": unexplained}


def report(problems, counts):
    for problem in problems:
        print(f"  {problem}")
    print(f"flows={counts['flows']} l2={counts['l2']} host={counts['host']} reasoned={counts['reasoned']} "
          f"unexplained={counts['unexplained']}")
    print("verdict=" + ("FAIL" if problems else "PASS"))
    return 1 if problems else 0


