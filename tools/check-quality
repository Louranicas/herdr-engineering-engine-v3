def refuse_untracked_inputs(root, names, deadline):
    """Refuse a required input that git would not carry.

    The gate reads this working tree; a clone reads only what git carries. Two required files
    sat under an ignored directory for a whole wave -- the survivor declarations and a
    recorded SDK fixture -- so every run here passed while a clone of the committed tree
    could not pass its own suite. Outside a git work tree the check cannot be made, and says
    so rather than reading as clean.
    """
    require_work_time(deadline, "git tracking check")
    probe = subprocess.run(["git", "-C", str(root), "rev-parse", "--is-inside-work-tree"],
                           capture_output=True, text=True, check=False,
                           timeout=max(1.0, deadline - time.monotonic()))
    if probe.returncode != 0 or probe.stdout.strip() != "true":
        print(f"required_inputs={len(names)} git_tracking=unmeasured (not a git work tree)",
              file=sys.stderr)
        return
    ignored = subprocess.run(["git", "-C", str(root), "check-ignore", "--no-index", "--stdin"],
                             input="\n".join(names) + "\n", capture_output=True, text=True,
                             check=False, timeout=max(1.0, deadline - time.monotonic()))
    if ignored.returncode not in (0, 1):
        raise ValueError("git check-ignore failed: " + ignored.stderr.strip())
    hidden = [line for line in ignored.stdout.splitlines() if line]
    # Excused by reason, never by silence: the rule is about AUTHORED inputs a clone cannot
    # regenerate or fetch. Every excused path is counted under its reason, so an exclusion
    # that starts swallowing authored files shows up as a moving number.
    excused = Counter()
    unexcused = []
    for name in hidden:
        reason = next((why for prefix, why in UNTRACKED_BY_DESIGN if name.startswith(prefix)
                       or f"/{prefix}" in f"/{name}"), None)
        if reason is None:
            unexcused.append(name)
        else:
            excused[reason] += 1
    detail = " ".join(f"{reason}={count}" for reason, count in sorted(excused.items()))
    print(f"required_inputs={len(names)} git_ignored={len(hidden)} "
          f"excused={sum(excused.values())} ({detail or 'none'}) unexcused={len(unexcused)}",
          file=sys.stderr)
    if unexcused:
        raise ValueError("Required input is ignored by git, so a clone cannot pass this gate: "
                         + ", ".join(unexcused))


