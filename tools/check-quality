def require_rust_test_summaries(stdout, expectations, label):
    summaries = re.findall(r"^test result: (.+)$", stdout, flags=re.MULTILINE)
    pattern = re.compile(r"ok\. (\d+) passed; 0 failed; 0 ignored; 0 measured; 0 filtered out; finished in .+$")
    parsed = [pattern.fullmatch(line) for line in summaries]
    actual = Counter(int(match.group(1)) for match in parsed if match is not None)
    required = Counter(expectations["test_counts"])
    for count, multiplicity in required.items():
        if actual[count] != multiplicity:
            raise ValueError("Missing/changed/filtered required Rust test count " + str(count) + ": " + label)
    if any(match is None for match in parsed) or actual != required:
        raise ValueError("Unexpected required Rust test summary inventory: " + label)
    for prefix, count in expectations.get("unit_test_counts", {}).items():
        names = re.findall(r"^test (" + re.escape(prefix) + r"\S+) \.\.\. ok$", stdout, flags=re.MULTILINE)
        if len(names) != count or len(set(names)) != count:
            raise ValueError("Missing/changed required Rust unit namespace " + prefix + ": " + label)
    marker = "T02_TRANSPORT_FINITE_CONTROLS: 5 passed; TH-DEV only"
    if expectations["has_t02"] and stdout.splitlines().count(marker) != 1:
        raise ValueError("Missing or duplicate T02 transport controls: " + label)



def rust_test_partitions(root):
    """Keep the selected finite targets within unchanged command/task deadlines."""
    if not any(present(root) for present in (has_t21, has_t07, has_t08, has_recovery, has_t08_contract, has_t07_startup)):
        return [("tests", ["--all-targets"])]
    # Validate the complete fixed census before selecting any subset. Cargo's
    # auto-discovery or conditional targets must not disappear through selection.
    rust_test_expectations(root)
    manifest = tomllib.loads((root / "Cargo.toml").read_text())
    package = manifest.get("package", {})
    if (package.get("autotests") is not False or package.get("autobins") is not False
            or manifest.get("workspace") != {"resolver": "3"}
            or manifest.get("lib") != {"name": "habitat_engine", "path": "src/lib.rs"}
            or manifest.get("example", []) != expected_examples(root) or "bench" in manifest):
        raise ValueError("Unaccounted Cargo target discovery in T21 partition")
    refuse_unsupported_cargo_inputs(root)
    names = []
    for target in manifest["test"]:
        name = target["name"]
        exact = {"name": name, "path": "tests/" + name + ".rs"}
        if name == "t02_transport":
            exact["harness"] = False
        if target != exact:
            raise ValueError("Conditional or substituted T21 partition target: " + name)
        names.append(name)
    separate = []
    if has_t21(root):
        separate.append(("tests-t21-process", ["--test", "t21_process"]))
    if has_t07(root):
        separate.append(("tests-t07-inventory", ["--test", "t07_inventory"]))
    if has_t08(root):
        # The native controls spawn the fixture client serially (RUST_TEST_THREADS=1)
        # and include multi-second cancellation waits; they are not charged to
        # the main command, whose release variant was already near its bound.
        separate.append(("tests-t08-native", ["--test", "t08_native"]))
    if has_recovery(root):
        separate.append(("tests-recovery", ["--test", "recovery"]))
    if has_t08_contract(root):
        # The contract battery spawns its daemon stand-in and client per case.
        separate.append(("tests-t08-contract", ["--test", "t08_contract"]))
    selected = {arguments[1] for _, arguments in separate}
    # The 18 T06 targets (449 controls, the Store/workspace/terminal/driver
    # suites) run in their own command. Evidence: the retained 795-control run
    # of 2026-09-21T05:36 needed 148 s for its release test command with the
    # tests still parallel and its scratch on tmpfs; the recipe now runs the
    # tests serially (RUST_TEST_THREADS=1) and t06_store alone publishes 4096
    # fsynced objects (PRAGMA synchronous=FULL plus sync_all per artifact),
    # which overran the 180-second bound twice when the scratch was on btrfs.
    # Every target still runs exactly once; no bound changes.
    main = ["--lib", "--bins"]
    t06 = []
    for name in sorted(names):
        if name in selected:
            continue
        (t06 if name.startswith("t06_") else main).extend(["--test", name])
    partitions = [("tests-main", main)]
    if t06:
        partitions.append(("tests-t06", t06))
    return [*partitions, *separate]


def run_rust_test_partitions(root, run, cargo, common, label, expectations):
    outputs = []
    for suffix, targets in rust_test_partitions(root):
        outputs.append(run(label + "-" + suffix, [cargo, "test", *common, *targets])["stdout"])
    # The original full-census and namespace oracle remains unchanged. Repetition,
    # omitted process output, transport-marker duplication and extra groups fail.
    require_rust_test_summaries("\n".join(outputs), expectations, label)


def merge_exception_observation(row, error):
    observation = getattr(error, "result", getattr(error, "bounded_process_result", None))
    if observation is None:
        row["observation_missing"] = True
        return False
    row.update(observation)
    return True


def apply_workspace_cleanup_status(report):
    if report.get("workspace_cleanup_complete") is False and report.get("status", "").startswith("pass"):
        report["status"] = "failed workspace cleanup"


def finalize_run(report, output, work, process_cleanup_complete, task_deadline, origin, propagating_error):
    report["elapsed_seconds"] = time.monotonic() - origin
    report["process_cleanup_complete"] = process_cleanup_complete
    report["cleanup_complete"] = process_cleanup_complete
    if work is not None and process_cleanup_complete:
        cleanup_paths = {stream: output / ("workspace-cleanup." + stream) for stream in ("stdout", "stderr")}
        cleanup_row = {"argv": ["/usr/bin/rm", "-rf", "--", str(work)]}
        report["workspace_cleanup"] = cleanup_row
        try:
            cleanup_result = run_bounded(
                cleanup_row["argv"], ROOT,
                {"PATH": "/usr/bin:/bin", "LC_ALL": "C"},
                cleanup_paths["stdout"], cleanup_paths["stderr"],
                task_deadline, command_timeout=CLEANUP_RESERVE,
                stream_limit=STREAM_LIMIT,
            )
            cleanup_row.update(cleanup_result)
        except BaseException as cleanup_error:
            merge_exception_observation(cleanup_row, cleanup_error)
            cleanup_row["error"] = f"{type(cleanup_error).__name__}: {cleanup_error}"
        for stream, path in cleanup_paths.items():
            if path.is_file():
                cleanup_row[stream] = {"path": path.name, "sha256": digest(path), "bytes": path.stat().st_size}
        report["workspace_removed"] = not work.exists()
        report["workspace_cleanup_complete"] = bool(
            cleanup_row.get("cleanup_complete") and cleanup_row.get("exit_code") == 0
            and not cleanup_row.get("timed_out") and not cleanup_row.get("output_limit_exceeded")
            and not cleanup_row.get("descendants_detected") and not cleanup_row.get("supervisor_error")
            and not cleanup_row.get("observation_missing") and not cleanup_row.get("error")
            and report["workspace_removed"]
        )
        if not report["workspace_cleanup_complete"]:
            report["cleanup_obligation"] = "Workspace removal failed or exceeded its cleanup bound"
    elif work is not None:
        report["workspace_removed"] = False
        report["workspace_cleanup_complete"] = False
        report["cleanup_obligation"] = "Retain owned workspace until live child custody is settled"
    if report["status"] == "running":
        report["status"] = "failed or interrupted development checks"
    apply_workspace_cleanup_status(report)
    (output / "results.json").write_text(json.dumps(report, indent=2) + "\n")
    print(output / "results.json", flush=True)
    if report.get("workspace_cleanup_complete") is False and propagating_error is None:
        raise RuntimeError("Workspace cleanup did not complete")


def digest(path):
    with path.open("rb") as source:
        return hashlib.file_digest(source, "sha256").hexdigest()


