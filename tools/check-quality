def validate_t05_features(metadata, *, t06=False, t21=False, ipc01=False):
    """Compare resolved metadata with the reviewed T05 package/feature tuple."""
    raw_nodes = metadata["resolve"]["nodes"]
    nodes = {node["id"]: node for node in raw_nodes}
    if len(nodes) != len(raw_nodes):
        raise ValueError("Duplicate resolved T05 metadata node")
    expected = dict(T05_FEATURES)
    if t06:
        # Fixed event polling selected by T06; no other feature broadening.
        expected["rustix"] = ("1.1.4", ["alloc", "default", "event", "fs", "process", "rand", "std"])
    if ipc01:
        # IPC01 reads the peer credential (SO_PEERCRED, RC03 section 5) through rustix/net: the one
        # broadening, and only with the socket source that needs it. No crate is added.
        version, features = expected["rustix"]
        expected["rustix"] = (version, sorted([*features, "net"]))
    if t21:
        expected["serde_json"] = ("1.0.151", ["default", "float_roundtrip", "std"])
    for name, (version, features) in expected.items():
        packages = [package for package in metadata["packages"] if package["name"] == name]
        if (len(packages) != 1 or packages[0]["version"] != version
                or packages[0]["id"] not in nodes
                or sorted(nodes[packages[0]["id"]]["features"]) != features):
            raise ValueError("Reviewed T05 resolved features differ: " + name)


