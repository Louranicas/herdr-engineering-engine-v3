def t21_package_inventory(seed, deadline):
    # These are the installed development paths used by released t21_process.
    # Pin the complete selected source trees; no inherited depot is claimed isolated.
    result = {}
    total = 0
    for relative in T21_PACKAGE_PATHS:
        names = tree_files(seed, relative, deadline)
        if not names:
            raise ValueError("Missing selected Julia package cache: " + relative)
        for name in names:
            total += (seed / name).stat().st_size
            if len(result) >= INVENTORY_FILE_LIMIT or total > INVENTORY_BYTE_LIMIT:
                raise ValueError("Selected Julia package cache inventory bound exceeded")
            result[name] = identity_digest(seed / name)
    return result


def verify_t21_package_inventory(seed, expected, deadline):
    if t21_package_inventory(seed, deadline) != expected:
        raise ValueError("Selected Julia package cache changed")


