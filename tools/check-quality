def t21_analysis_environment(environment, output):
    path = output / "julia-t21-analysis-report.json"
    if path.exists() or path.is_symlink():
        raise ValueError("Numerical report destination already exists")
    selected = environment.copy()
    selected["T21_JULIA_REPORT"] = str(path)
    return selected


def require_t21_analysis_report(path, expected_j01, request_sha256):
    if path.is_symlink() or not path.is_file():
        raise ValueError("Missing regular numerical report")
    with path.open("rb") as stream:
        raw = stream.read(65_537)
    if len(raw) > 65_536 or raw != expected_j01:
        raise ValueError("Numerical report differs from retained J01 or exceeds bound")
    decoded = json.loads(raw)
    if not isinstance(decoded, dict) or decoded.get("request_sha256") != "sha256:" + request_sha256:
        raise ValueError("Numerical report request binding differs")
    return {"path": str(path), "sha256": hashlib.sha256(raw).hexdigest(),
            "bytes": len(raw), "request_sha256": "sha256:" + request_sha256}


def require_t21_julia_summaries(stdout, stderr, cohort=False):
    """The Julia analysis file's assertion groups, exactly. `cohort` adds T22's group, which
    julia/test/analysis.jl appends to the T21 file (see its comment for why); without it the
    gate required three headers and refused a file that had correctly grown a fourth."""
    expected = {"T21 descriptive evaluator": 82, "T21 numerical boundary controls": 10,
                "T21 deferred string decoding": 7}
    if cohort:
        expected["T22 cohort cohesion"] = 168
    rows = re.findall(r"^(T2[12] [^|\n]+)\|([^\n]+)$", stdout, re.MULTILINE)
    headers = re.findall(r"^Test Summary:[^|\n]*\|([^\n]+)$", stdout, re.MULTILINE)
    if stderr or len(rows) != len(expected) or len(headers) != len(expected) or any(
            header.split() not in (["Pass", "Total"], ["Pass", "Total", "Time"])
            for header in headers):
        raise ValueError("Unexpected T21 Julia evaluator summary or diagnostics")
    seen = set()
    for name, columns in rows:
        name = name.strip()
        values = columns.split()
        if (name in seen or name not in expected or len(values) not in (2, 3)
                or values[:2] != [str(expected[name])] * 2
                or (len(values) == 3 and not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?s", values[2]))):
            raise ValueError("Missing exact T21 Julia evaluator assertion group")
        seen.add(name)
    if seen != set(expected):
        raise ValueError("Missing exact T21 Julia evaluator assertion group")


def retained_command_environment(environment, output, label):
    if not re.fullmatch(r"[a-z0-9-]+", label):
        raise ValueError("Invalid retained command label")
    selected = environment.copy()
    for variable, directory in (("T13_PROCESS_EVIDENCE", "t13-process-evidence"),
                                ("T21_PROCESS_EVIDENCE", "t21-process-evidence")):
        if variable in selected:
            selected[variable] = str(output / directory / label)
    return selected


def require_work_time(deadline, stage):
    if time.monotonic() >= deadline:
        raise TimeoutError("Work deadline reached before " + stage)


def tree_files(root, relative_root, deadline, suffix=None, allow_internal_symlinks=False):
    files = []
    total = 0
    base = root / relative_root
    for path in base.rglob("*"):
        require_work_time(deadline, "inventory " + relative_root)
        if path.is_symlink():
            target = path.resolve(strict=True)
            if (not allow_internal_symlinks or not target.is_relative_to(base.resolve())
                    or not target.is_file()):
                raise ValueError("Symlink is unsupported in quality inventory: " + str(path))
        if not path.is_file() or (suffix is not None and path.suffix != suffix):
            continue
        total += path.stat().st_size
        files.append(str(path.relative_to(root)))
        if len(files) > INVENTORY_FILE_LIMIT or total > INVENTORY_BYTE_LIMIT:
            raise ValueError("Quality inventory bound exceeded: " + relative_root)
    return files


def identity_digest(path):
    if not path.is_symlink():
        return digest(path)
    identity = hashlib.sha256()
    identity.update(b"symlink\0")
    identity.update(os.readlink(path).encode())
    identity.update(b"\0")
    identity.update(bytes.fromhex(digest(path.resolve(strict=True))))
    return identity.hexdigest()


_JULIA_PRECOMPILE_LINES = (
    re.compile(r"Precompiling packages\.\.\."),
    re.compile(r"\s+\d+(?:\.\d+)? ms  ✓ .+(?: \(serial\))?"),
    re.compile(r"\s+\d+ (?:dependency|dependencies) successfully precompiled in \d+ seconds?(?:\. \d+ already precompiled\.)?"),
)


def validate_julia_precompile_stderr(text):
    for line in text.splitlines():
        if line and not any(pattern.fullmatch(line) for pattern in _JULIA_PRECOMPILE_LINES):
            raise ValueError("Unexpected Julia baseline stderr: " + line)


