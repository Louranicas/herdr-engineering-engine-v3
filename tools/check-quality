def daemon_stand_in(root, source, required):
    """Pin the live process a T08 battery pins as its daemon, from the test's own declaration.

    The adapter re-hashes that executable through /proc/<pid>/exe; the battery
    names it once as `const EXECUTABLE`. Two declarations are ambiguous and
    refuse; none is permitted only where the battery may pin its own test
    executable instead (required=False).
    """
    found = re.findall(r"const EXECUTABLE: &'static str = \"(/[^\"]+)\";", (root / source).read_text())
    if len(found) > 1 or (required and not found):
        raise ValueError("Missing or ambiguous daemon stand-in declaration: " + source)
    if not found:
        return None
    path = Path(found[0])
    if not path.is_file():
        raise ValueError("Missing daemon stand-in executable: " + found[0])
    return {"path": found[0], "resolved": str(path.resolve(strict=True)), "sha256": digest(path),
            "bytes": path.stat().st_size, "declared_in": source}


def native_client_interpreter(root, fixture=NATIVE_CLIENT_FIXTURE):
    """Pin the interpreter named by the native client fixture's own first line.

    tests/t08_native.rs writes the fixture with mode 0o700 and the adapter
    executes it directly, so the kernel resolves this line; the evidence pin
    must name the same file. Only an absolute, argument-free interpreter line
    ending in a newline is accepted; env-style lookups are refused because
    they would make the pin depend on the child's PATH.
    """
    with (root / fixture).open("rb") as stream:
        first = stream.readline(4097)
    if not first.startswith(b"#!/") or not first.endswith(b"\n") or len(first) > 4096:
        raise ValueError("Unsupported native client interpreter line")
    interpreter = first[2:-1].decode("ascii", errors="strict")
    if not interpreter.startswith("/") or any(character.isspace() for character in interpreter):
        raise ValueError("Unsupported native client interpreter line")
    path = Path(interpreter)
    if not path.is_file():
        raise ValueError("Missing native client interpreter: " + interpreter)
    return {"path": interpreter, "resolved": str(path.resolve(strict=True)), "sha256": digest(path)}


