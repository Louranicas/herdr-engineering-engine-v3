def sources_substantive(root, sources):
    for relative in sources:
        path = root / relative
        if path.is_symlink():
            return True
        if path.is_file() and any(line.strip() and not line.lstrip().startswith("//")
                                  for line in path.read_text().splitlines()):
            return True
    return False


def extension_present(root, prefix, sources):
    manifest = tomllib.loads((root / "Cargo.toml").read_text())
    if any(str(row.get("name", "")).startswith(prefix + "_") for row in manifest.get("test", [])):
        return True
    return sources_substantive(root, sources)


