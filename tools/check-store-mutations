ROSTER_MUTATION_COUNT = 8


def selected_profile(module, quality, root):
    expectations = quality.rust_test_expectations(root)
    if not expectations.get("has_t04") or quality.T04_TEST_COUNT != TEST_COUNT:
        raise ValueError("Reviewed T04 source/target/floor is missing")
    if module == "store":
        task, prefix, mutations = "T04", "store::tests::", MUTATIONS
    elif module == "roster":
        if (not expectations.get("has_t05") or type(ROSTER_MUTATION_COUNT) is not int
                or ROSTER_MUTATION_COUNT <= 0 or not isinstance(ROSTER_MUTATIONS, tuple)
                or len(ROSTER_MUTATIONS) != ROSTER_MUTATION_COUNT):
            raise ValueError("Reviewed T05 roster mutation declarations are pending")
        task, prefix, mutations = "T05", "store::roster_tests::", ROSTER_MUTATIONS
    else:
        raise ValueError("Unsupported mutation module")
    if (not mutations or any(len(row) != 6 or not all(isinstance(value, str) and value for value in row) for row in mutations)
            or len({row[0] for row in mutations}) != len(mutations)
            or len({row[2] for row in mutations}) != len(mutations)):
        raise ValueError("Invalid fixed mutation declarations")
    units = expectations.get("unit_test_counts", {})
    count = sum(units.values()) if expectations.get("has_t05") else TEST_COUNT
    return {"module": module, "task": task, "prefix": prefix, "mutations": mutations,
            "library_test_count": count, "unit_test_counts": units, "expectations": expectations}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--module", choices=("store", "roster"), default="store")
    arguments = parser.parse_args()
    loader = SourceFileLoader("t04_quality", str(ROOT / "tools/check-quality"))
    quality = module_from_spec(spec_from_loader(loader.name, loader))
    loader.exec_module(quality)
    profile = selected_profile(arguments.module, quality, ROOT)
    mutations = profile["mutations"]
    origin = time.monotonic()
    deadline = origin + 900
    output = ROOT / ("evidence/implementation/" + profile["task"] + "/mutation-runs") / datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    output.mkdir(parents=True, exist_ok=False)
    report = {"scope": profile["task"] + " fixed development mutation controls; no module admission",
              "profile": "TH-DEV", "status": "running", "module_admission": False,
              "commands": [], "mutations": [], "subject_files": {}, "module": profile["module"],
              "rust_test_expectations": profile["expectations"], "library_test_count": profile["library_test_count"]}
    workspace = None
    cleanup = True
    try:
        names = quality.quality_subject_paths(ROOT, deadline, True) + list(REQUIRED_SUBJECTS) + [quality.sqlite_static.ARCHIVE_NAME]
        quality.refuse_unsupported_cargo_inputs(ROOT)
        workspace = Path(tempfile.mkdtemp(prefix="hee3-store-mutations-"))
        quality.refuse_ancestor_cargo_configuration(workspace)
        report["workspace"] = str(workspace)
        total_bytes = 0
        for name in sorted(set(names)):
            quality.require_work_time(deadline, "mutation subject copy")
            source = ROOT / name
            if source.is_symlink() or not source.is_file():
                raise ValueError("Nonregular mutation input: " + name)
            total_bytes += source.stat().st_size
            if len(report["subject_files"]) >= quality.INVENTORY_FILE_LIMIT or total_bytes > quality.INVENTORY_BYTE_LIMIT:
                raise ValueError("Mutation subject inventory bound exceeded")
            target = workspace / name
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(source, target)
            report["subject_files"][name] = quality.digest(target)
            if quality.digest(source) != report["subject_files"][name]:
                raise ValueError("Input drift during copy: " + name)
        compiler = Path.home() / ".rustup/toolchains/1.98.0-x86_64-unknown-linux-gnu/bin"
        binaries = {name: compiler / name for name in ("cargo", "rustc", "rustdoc")}
        report["executables"] = {name: {"path": str(path), "sha256": quality.digest(path)} for name, path in binaries.items()}
        vendor, cargo_home = workspace / "vendor", workspace / "cargo-home"
        report["offline_dependencies"] = quality.rust_offline.materialize(
            workspace / "Cargo.lock", workspace / quality.RUST_OFFLINE_BUNDLE,
            vendor, cargo_home, deadline)
        environment = {"PATH": str(compiler) + ":/usr/bin:/bin", "LC_ALL": "C",
                       "TMPDIR": str(workspace), "CARGO_HOME": str(cargo_home),
                       "CARGO_TARGET_DIR": str(workspace / "target"), "CARGO_BUILD_JOBS": quality.BUILD_JOBS,
                       "CARGO_NET_OFFLINE": "true", "RUSTUP_TOOLCHAIN": "1.98.0",
                       "RUSTC": str(binaries["rustc"]), "RUSTDOC": str(binaries["rustdoc"]),
                       "RUSTFLAGS": "-Dwarnings", "RUSTDOCFLAGS": "-Dwarnings",
                       "PYTHONDONTWRITEBYTECODE": "1", "PYTHONWARNINGS": "error"}
        report["environment"] = environment.copy()

        def run(label, argv, expected=0):
            nonlocal cleanup
            row = {"id": label, "argv": argv, "cwd": str(workspace), "environment": environment.copy(),
                   "expected_exit_code": expected}
            report["commands"].append(row)
            streams = {name: output / (label + "." + name) for name in ("stdout", "stderr")}
            try:
                row.update(quality.run_bounded(argv, workspace, environment, streams["stdout"], streams["stderr"],
                                              deadline, stream_limit=quality.STREAM_LIMIT))
            except BaseException as error:
                if not quality.merge_exception_observation(row, error):
                    cleanup = False
                row["error"] = f"{type(error).__name__}: {error}"
                raise
            finally:
                if row.get("started") and not row.get("cleanup_complete"):
                    cleanup = False
                for name, path in streams.items():
                    if path.is_file():
                        row[name] = {"path": path.name, "sha256": quality.digest(path), "bytes": path.stat().st_size}
                (output / "results.json").write_text(json.dumps(report, indent=2) + "\n")
            if (row["exit_code"] != expected or not row["started"] or not row["cleanup_complete"]
                    or row["timed_out"] or row["output_limit_exceeded"] or row["descendants_detected"]):
                raise ValueError("Unexpected mutation process outcome: " + label)
            texts = {}
            for name, path in streams.items():
                with path.open("rb") as raw:
                    data = raw.read(quality.STREAM_LIMIT + 1)
                if len(data) > quality.STREAM_LIMIT:
                    raise ValueError("Retained stream exceeds bound: " + label)
                texts[name] = data.decode("utf-8", errors="strict")
            return texts

        cargo = str(binaries["cargo"])
        metadata = run("offline-dependency-resolution", [cargo, "metadata", "--locked", "--offline", "--format-version=1"])
        if profile["expectations"].get("has_t05"):
            quality.validate_t05_features_at(json.loads(metadata["stdout"]), ROOT)
        quality.sqlite_static.validate_features(json.loads(metadata["stdout"]))
        report["sqlite_static"] = {}
        environment.update(quality.sqlite_static.build(
            workspace / quality.sqlite_static.ARCHIVE_NAME, workspace / "sqlite-private", deadline,
            run, report["sqlite_static"]))
        report["environment"] = environment.copy()

        def tests(label, selected=None):
            argv = [cargo, "test", "--locked", "--offline", "--lib"]
            if selected is not None:
                argv += [selected, "--", "--exact"]
            text = run(label, argv, 0 if selected is None else 101)["stdout"]
            if selected is None:
                quality.require_rust_test_summaries(text, {"test_counts": [profile["library_test_count"]],
                    "has_t02": False, "unit_test_counts": profile["unit_test_counts"]}, label)
            else:
                summary = (r"^test result: FAILED\. 0 passed; 1 failed; 0 ignored; 0 measured; "
                           + str(profile["library_test_count"] - 1) + r" filtered out; finished in .+$")
                if text.splitlines().count(f"test {selected} ... FAILED") != 1 or len(re.findall(summary, text, re.MULTILINE)) != 1:
                    raise ValueError("Missing intended test outcome: " + label)
            print(label + ": expected outcome observed", flush=True)

        originals = {name: (workspace / name).read_bytes() for name in {row[1] for row in mutations}}
        for label, name, _, before, after, _ in mutations:
            original = originals[name].decode("utf-8")
            if original.count(before) != 1 or before == after:
                raise ValueError("Mutation selector is not unique or effective: " + label)
        tests("baseline")
        for label, name, test, before, after, basis in mutations:
            source = workspace / name
            changed = originals[name].decode("utf-8").replace(before, after, 1).encode("utf-8")
            source.write_bytes(changed)
            snapshot = output / (label + ".rs")
            snapshot.write_bytes(changed)
            selected = profile["prefix"] + test
            row = {"id": label, "source_path": name, "test": selected, "expectation": basis,
                   "before": before, "after": after, "source_snapshot": snapshot.name, "sha256": quality.digest(snapshot)}
            report["mutations"].append(row)
            try:
                tests(label, selected)
                row["outcome"] = "intended test failed"
            finally:
                source.write_bytes(originals[name])
        tests("restored-benign")
        quality.sqlite_static.verify(workspace / "sqlite-private", report["sqlite_static"], deadline)
        quality.rust_offline.verify_materialized(vendor, cargo_home, report["offline_dependencies"], deadline)
        for name, expected in report["subject_files"].items():
            if quality.digest(workspace / name) != expected or quality.digest(ROOT / name) != expected:
                raise ValueError("Mutation input drift: " + name)
        report["status"] = ("pass seven intended mutations and restored benign baseline" if profile["module"] == "store"
                            else "pass " + str(len(mutations)) + " intended mutations and restored benign baseline")
    except BaseException as error:
        report["error"] = f"{type(error).__name__}: {error}"
        raise
    finally:
        quality.finalize_run(report, output, workspace, cleanup, origin + 1200, origin, sys.exc_info()[0])


if __name__ == "__main__":
    main()
